<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nutzungsdaten: gibt der Nutzer in den Einstellungen frei („Nutzungsdatenzugriff“). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates von selbst (Selbstupdate.kt): Die App installiert nur sich selbst, aus den
         Releases dieses Repos. REQUEST_INSTALL_PACKAGES gibt Tobi einmal frei („Unbekannte Apps
         installieren“); ohne UPDATE_PACKAGES_WITHOUT_USER_ACTION fragte Android jedes Mal. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Anrufliste für die Bewerbungszentrale (Anrufe.kt): erst nach Tobis Freigabe in der App. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Kontakte für die Nummern aus den Bewerbungen benennen (Kontakte.kt): erst nach Tobis Freigabe in der App. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Anrufer erkennen (Anrufer.kt): wer gerade anruft, und die Mitteilung mit dem Briefing. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nach einem Neustart den Wecker fürs Widget neu stellen (Takt.kt). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Statt QUERIES_ALL_PACKAGES: nur Apps mit Eintrag im App-Drawer und Startbildschirme. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Bis Android 11 genügt allowBackup="false"; ab 12 regelt datenregeln.xml den Umzug. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/datenregeln"
        tools:ignore="DataExtractionRules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Thema">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Der Claude-Schlüssel aus der Bewerbungszentrale (bildschirmzeit://ki#…), nur nach „Claude-Schlüssel holen“. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="ki"
                    android:scheme="bildschirmzeit" />
            </intent-filter>
        </activity>

        <!-- bildschirmzeit://firefox?url=… aus der Bewerbungszentrale (FirefoxEinstieg.kt): öffnet die
             Adresse in Firefox als richtigen Tab – ohne eigene Oberfläche, gleich wieder zu, nicht in
             den zuletzt benutzten Apps. BROWSABLE, weil Firefox es an jeden Link hängt, den es an eine
             App gibt; eigene Task-Affinität, damit der Bildschirmzeit-Task nicht nach vorn kommt. -->
        <activity
            android:name=".FirefoxOeffnen"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="firefox"
                    android:scheme="bildschirmzeit" />
            </intent-filter>
        </activity>

        <!-- Anrufer erkennen (Anrufer.kt): PHONE_STATE kommt nur vom System. -->
        <receiver
            android:name=".AnrufEmpfaenger"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BildschirmzeitWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Wecker (eigener PendingIntent), Neustart und Update – nicht exportiert, das System erreicht ihn trotzdem. -->
        <receiver
            android:name=".Hintergrund"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Status der Installer-Sitzung: nur über den expliziten PendingIntent der App. -->
        <receiver
            android:name=".UpdateStatus"
            android:exported="false" />

        <!--
            Freiwillig: Webseiten in Firefox einzeln (Webseiten.kt). Eine Bedienungshilfe,
            die nur Firefox sieht und nur dessen Adresszeile liest. Binden darf nur das
            System (BIND_ACCESSIBILITY_SERVICE), deshalb exportiert.
        -->
        <service
            android:name=".WebseitenDienst"
            android:exported="true"
            android:label="@string/webseiten_dienst_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/webseiten_dienst" />
        </service>
    </application>
</manifest>
