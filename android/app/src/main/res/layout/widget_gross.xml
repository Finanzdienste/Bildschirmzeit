<?xml version="1.0" encoding="utf-8"?>
<!-- Widget ab 3×2: Ring links, rechts „Bildschirmzeit“, Top 3, „Andere Apps“ (der graue Rest) und Stand. Gefüllt von WidgetAnsicht.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hintergrund"
    android:baselineAligned="false"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/widget_rand">

    <FrameLayout
        android:id="@+id/ring_rahmen"
        android:layout_width="@dimen/ring_gross"
        android:layout_height="@dimen/ring_gross">

        <ImageView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/gesamt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.92"
            android:maxLines="3"
            android:padding="@dimen/ring_innen"
            android:text="@string/strich"
            android:textColor="@color/widget_text"
            android:textSize="20sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_abstand"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/zeile1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/punkt1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/punkt" />

            <ImageView
                android:id="@+id/symbol1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/name1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/zeit1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/widget_text_leise"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zeile2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/punkt2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/punkt" />

            <ImageView
                android:id="@+id/symbol2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/name2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/zeit2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/widget_text_leise"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zeile3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/punkt3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/punkt" />

            <ImageView
                android:id="@+id/symbol3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/name3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/zeit3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/widget_text_leise"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Alle übrigen Apps zusammen: der graue Teil des Rings. Ohne Symbol – so bleibt „Andere Apps“ auch bei 4×2 mit langen Zeiten ganz. -->
        <LinearLayout
            android:id="@+id/zeile4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/punkt4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/punkt" />

            <TextView
                android:id="@+id/name4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_andere"
                android:textColor="@color/widget_text_leise"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/zeit4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/widget_text_leise"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/leer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_leer"
            android:textColor="@color/widget_text_leise"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_leise"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
