<?xml version="1.0" encoding="utf-8"?>
<!--
    Der App-Bildschirm: oben die Statistik (Tag, Woche, Monat), darunter die
    Einrichtung (Nutzungsdaten, Web-Apps, Widget), die Update-Karte und Löschen.
    Fehlt die Erlaubnis, rückt deren Karte vor die Statistik; öffnet das Widget
    die App wegen eines Updates, steht die Update-Karte oben (MainActivity.ordnen).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/inhalt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/kopf_titel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/kopf_titel"
            android:textColor="@color/text"
            android:textSize="30sp" />

        <LinearLayout
            android:id="@+id/statistik_karte"
            style="@style/Karte">

            <LinearLayout
                android:id="@+id/reiter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/reiter_tag"
                    style="@style/Reiter"
                    android:text="@string/reiter_tag" />

                <TextView
                    android:id="@+id/reiter_woche"
                    style="@style/Reiter"
                    android:layout_marginStart="6dp"
                    android:text="@string/reiter_woche" />

                <TextView
                    android:id="@+id/reiter_monat"
                    style="@style/Reiter"
                    android:layout_marginStart="6dp"
                    android:text="@string/reiter_monat" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/zurueck"
                    style="@style/Pfeil"
                    android:contentDescription="@string/zurueck"
                    android:text="@string/pfeil_zurueck" />

                <!-- Passt der Titel nicht in eine Zeile (größere Schrift, „28. Dez. – 3. Jan. 2027“), wird er kleiner statt gekürzt. -->
                <TextView
                    android:id="@+id/zeitraum_titel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/weiter"
                    style="@style/Pfeil"
                    android:contentDescription="@string/weiter"
                    android:text="@string/pfeil_weiter" />
            </LinearLayout>

            <!-- Eine App gewählt (Tipp auf ihre Zeile): ihr Symbol und Name, rechts zurück zu allen Apps. -->
            <LinearLayout
                android:id="@+id/app_kopf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/app_kopf_symbol"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/app_kopf_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/alle_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/knopf_leise"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/alle_apps"
                    android:textColor="@color/akzent"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/gesamt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/strich"
                android:textColor="@color/text"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/schnitt"
                style="@style/Fliesstext"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:visibility="gone" />

            <de.finanzdienste.bildschirmzeit.Balken
                android:id="@+id/balken"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/luecken"
                style="@style/Hinweis"
                android:gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/app_liste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/statistik_hinweis"
                style="@style/Hinweis"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <!-- Eine App oder Seite gewählt: unten, leise – sie nie mehr mit Namen zeigen (Diskret.kt). -->
            <Button
                android:id="@+id/seite_zusammenfassen"
                style="@style/Knopf.Leise"
                android:text="@string/seite_zusammenfassen"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/erlaubnis_karte"
            style="@style/Karte">

            <TextView
                android:id="@+id/schritt1_titel"
                style="@style/Ueberschrift"
                android:text="@string/schritt1_titel" />

            <TextView
                android:id="@+id/schritt1_text"
                style="@style/Fliesstext"
                android:text="@string/schritt1_text" />

            <Button
                android:id="@+id/schritt1_knopf"
                style="@style/Knopf"
                android:text="@string/schritt1_knopf" />

            <TextView
                android:id="@+id/schritt1_hinweis"
                style="@style/Hinweis"
                android:text="@string/schritt1_hinweis" />

            <Button
                android:id="@+id/app_info"
                style="@style/Knopf.Leise"
                android:text="@string/app_info" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/web_karte"
            style="@style/Karte">

            <TextView
                style="@style/Ueberschrift"
                android:text="@string/schritt2_titel" />

            <TextView
                style="@style/Fliesstext"
                android:text="@string/schritt2_text" />

            <LinearLayout
                android:id="@+id/web_liste"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_karte"
            style="@style/Karte">

            <TextView
                android:id="@+id/schritt3_titel"
                style="@style/Ueberschrift"
                android:text="@string/schritt3_titel" />

            <TextView
                android:id="@+id/schritt3_text"
                style="@style/Fliesstext"
                android:text="@string/schritt3_text" />

            <Button
                android:id="@+id/schritt3_knopf"
                style="@style/Knopf"
                android:text="@string/schritt3_knopf" />

            <TextView
                android:id="@+id/schritt3_anleitung"
                style="@style/Hinweis"
                android:text="@string/schritt3_anleitung"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Freiwillig: Webseiten in Firefox einzeln (WebseitenDienst). -->
        <LinearLayout
            android:id="@+id/webseiten_karte"
            style="@style/Karte">

            <TextView
                android:id="@+id/schritt4_titel"
                style="@style/Ueberschrift"
                android:text="@string/schritt4_titel" />

            <TextView
                android:id="@+id/schritt4_text"
                style="@style/Fliesstext"
                android:text="@string/schritt4_text" />

            <TextView
                android:id="@+id/schritt4_stand"
                style="@style/Hinweis"
                android:visibility="gone" />

            <Button
                android:id="@+id/schritt4_knopf"
                style="@style/Knopf"
                android:text="@string/schritt4_knopf" />

            <TextView
                android:id="@+id/schritt4_anleitung"
                style="@style/Hinweis"
                android:text="@string/schritt4_anleitung" />
        </LinearLayout>

        <!-- Diskret (Diskret.kt): was nie mit Namen erscheint, „Wieder einzeln zeigen“ für die eigene Liste. -->
        <LinearLayout
            android:id="@+id/diskret_karte"
            style="@style/Karte">

            <TextView
                android:id="@+id/diskret_titel"
                style="@style/Ueberschrift"
                android:text="@string/diskret_titel" />

            <TextView
                android:id="@+id/diskret_text"
                style="@style/Fliesstext"
                android:text="@string/diskret_text" />

            <TextView
                android:id="@+id/diskret_eigene"
                style="@style/Hinweis"
                android:visibility="gone" />

            <Button
                android:id="@+id/diskret_wieder_zeigen"
                style="@style/Knopf.Leise"
                android:text="@string/wieder_einzeln_zeigen"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/update_karte"
            style="@style/Karte"
            android:visibility="gone">

            <TextView
                android:id="@+id/update_titel"
                style="@style/Ueberschrift"
                android:text="@string/update_titel" />

            <TextView
                android:id="@+id/update_text"
                style="@style/Fliesstext" />

            <Button
                android:id="@+id/update_knopf"
                style="@style/Knopf"
                android:visibility="gone" />

            <!-- Zweiter Knopf, leise: „Noch einmal versuchen“ unter „Automatische Sperre öffnen“. -->
            <Button
                android:id="@+id/update_knopf2"
                style="@style/Knopf.Leise"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Androids Meldung zum Fehlschlag, klein (UpdateAnzeige.diagnose). -->
            <TextView
                android:id="@+id/update_diagnose"
                style="@style/Hinweis"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/loeschen"
            style="@style/Knopf.Ohne"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="@string/loeschen" />

        <TextView
            android:id="@+id/version"
            style="@style/Hinweis"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
