<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Thema" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/akzent</item>
        <item name="android:colorAccent">@color/akzent</item>
        <item name="android:windowBackground">@color/app_hintergrund</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_leise</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Randlos (bis Android 14 nötig, ab 15 ohnehin): Die App zeichnet unter den Leisten. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="Karte">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/karte</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Ueberschrift">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Fliesstext">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/text_leise</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Hinweis" parent="Fliesstext">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Knopf" parent="android:Widget.Material.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/knopf</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/akzent_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Knopf.Leise">
        <item name="android:background">@drawable/knopf_leise</item>
        <item name="android:textColor">@color/akzent</item>
    </style>

    <style name="Knopf.Ohne">
        <item name="android:background">@drawable/knopf_ohne</item>
        <item name="android:textColor">@color/warnung</item>
    </style>
</resources>
