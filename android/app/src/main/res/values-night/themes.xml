<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Thema" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/akzent</item>
        <item name="android:colorAccent">@color/akzent</item>
        <item name="android:windowBackground">@color/app_hintergrund</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_leise</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Randlos (bis Android 14 nötig, ab 15 ohnehin): Die App zeichnet unter den Leisten. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
