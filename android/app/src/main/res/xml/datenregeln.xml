<?xml version="1.0" encoding="utf-8"?>
<!-- Die Kennung bleibt auf diesem Gerät: weder in die Cloud-Sicherung noch beim Umzug aufs neue Handy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
