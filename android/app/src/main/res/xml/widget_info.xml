<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard 4×2, verkleinerbar bis 2×2 (dann nur der Ring). minWidth/minHeight
  nach der Formel 70 × Zellen − 30 dp für Startbildschirme vor Android 12;
  ab Android 12 gelten targetCellWidth/Height. updatePeriodMillis="0": Es
  rechnen ein nicht weckender Wecker alle 2 Minuten, solange das Handy
  benutzt wird, und gleich nach dem Einschalten (Takt.kt), dazu WorkManager
  alle 15 Minuten (Aktualisierung.kt); beide nach einem Neustart wieder. Ein
  Android-Takt dazu würde das Handy alle 30 Minuten aufwecken, auch nachts,
  und doppelt rechnen und funken.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_beschreibung"
    android:initialLayout="@layout/widget_gross"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_vorschau"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
